        - # this file test the behavior of `SqrtRational`
        - 
        1 function test_sqrtrational()
        1     x = 3//5 * exact_sqrt(2//3)
        1     @test zero(x) == 0
        1     @test 0*x == 0
        1     @test (0*x).r == 1
        1     @test (0*x) == zero(x)
        1     @test 1 == one(x)
        1     @test x*inv(x) == one(x)
        1     @test inv(x) == one(x)/x
        1     @test sign(+x) == 1
        1     @test sign(-x) == -1
        1     @test sign(0*x) == 0
        1     @test signbit(+x) == false
        1     @test signbit(-x) == true
        1     @test signbit(0*x) == false
        1     @test x == x
        1     @test x != -x
        1     @test x == copy(x)
        1     @test x - exact_sqrt(2//3) == SqrtRational(3//5 - 1, 2//3)
        1     @test 0 - zero(x) == zero(x)
        1     @test x - x == 0
        - end
        - 
        1 function test_show()
        1     x = exact_sqrt(3)
        1     y = exact_sqrt(3//5)
        1     @test string(zero(x)) == "0"
        1     @test string(one(x)) == "1"
        1     @test string(2//3*one(x)) == "2//3"
        1     @test string(x) == "√3"
        1     @test string(-x) == "-√3"
        1     @test string(-y) == "-√(3//5)"
        1     @test string(y) == "√(3//5)"
        1     @test string(3*x) == "3√3"
        1     @test string(2//3*y) == "2//3√(3//5)"
        -     
        1     io = IOBuffer()
        1     show(io, "text/markdown", zero(x))
        1     @test String(take!(io)) == raw"$0$" * "\n"
        1     show(io, "text/markdown", one(x))
        1     @test String(take!(io)) == raw"$1$" * "\n"
        1     show(io, "text/markdown", 2//3*one(x))
        1     @test String(take!(io)) == raw"$\frac{2}{3}$" * "\n"
        1     show(io, "text/markdown", x)
        1     @test String(take!(io)) == raw"$\sqrt{3}$" * "\n"
        1     show(io, "text/markdown", y)
        1     @test String(take!(io)) == raw"$\sqrt{\frac{3}{5}}$" * "\n"
        1     show(io, "text/markdown", -x)
        1     @test String(take!(io)) == raw"$-\sqrt{3}$" * "\n"
        1     show(io, "text/markdown", -y)
        1     @test String(take!(io)) == raw"$-\sqrt{\frac{3}{5}}$" * "\n"
        1     show(io, "text/markdown", 3*x)
        1     @test String(take!(io)) == raw"$3\sqrt{3}$" * "\n"
        1     show(io, "text/markdown", 2//3*y)
        1     @test String(take!(io)) == raw"$\frac{2}{3}\sqrt{\frac{3}{5}}$" * "\n"
        - end
        - 
        1 function test_simplify()
        1     @test simplify(2^7 * 3^3) == (2 * 3, 2^3 * 3)
        1     @test simplify(exact_sqrt(3//4)) == exact_sqrt(3) / 2
        1     test_simplify_with_6j()
        - end
        - 
        1 function test_simplify_with_6j()
        1     test_range = 2:1//2:4
        1     for j1 in test_range
        5     for j2 in test_range
       25     for j3 in test_range
      125     for j4 in test_range
      625     for j5 in test_range
     3125     for j6 in test_range
    15625         dj1, dj2, dj3, dj4, dj5, dj6 = Int.((2j1, 2j2, 2j3, 2j4, 2j5, 2j6))
    15625         if check_6j(dj1, dj2, dj3, dj4, dj5, dj6)
     2025             x = d6j(dj1,dj2,dj3,dj4,dj5,dj6)
     2025             @test x == simplify(x)
        -         end
    15625     end end end end end end
        - end
