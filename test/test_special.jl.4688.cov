        - # this file test the some special case if Wigner symbols
        - # especially the when one of arguement is equal to zero
        - # All formulat are refered in
        - # [1] D. A. Varshalovich, A. N. Moskalev and V. K. Khersonskii, Quantum Theory of Angular Momentum, (World Scientific, 1988).
        - 
        - # test special condition for CG coefficients
        - # Ref[1], P248, Sec 8.5, Formula(1)
        1 function test_special_CG(test_range::AbstractArray)
        2     for j = test_range
       20         for m = -j:1:j
      230             cg = CG(j, j, 0, m, -m, 0)
      460             mycg = iphase(Int(j - m)) / exact_sqrt(2j + 1)
      230             @test cg == mycg
      440         end
       20     end
        - end
        - 
        1 function test_CG0(test_range::AbstractArray)
      101     for j1 = test_range, j2 = test_range, j3 = test_range
     1000         if check_couple(Int(2j1), Int(2j2), Int(2j3))
      640             cg0 = CG0(j1, j2, j3)
     1280             tj = threeJ(j1, j2, j3, 0, 0, 0) * iphase(2j1 + j3) * exact_sqrt(2j3 + 1)
      640             @test cg0 == tj
        -         end
     1000     end
        - end
        - 
        1 function test_CGspin()
        1     wigner_init_float(2, "Jmax", 3)
        1     @test fCGspin(1, 1, 1) ≈ fCG(1, 1, 2, 1, 1, 2) ≈ 1.0
        1     @test fCGspin(1, 1, 0) ≈ fCG(1, 1, 0, 1, 1, 2) ≈ 0.0
        1     @test fCGspin(1, -1, 1) ≈ fCG(1, 1, 2, 1, -1, 0) ≈ 1/√2
        1     @test fCGspin(1, -1, 0) ≈ fCG(1, 1, 0, 1, -1, 0) ≈ 1/√2
        1     @test fCGspin(-1, 1, 1) ≈ fCG(1, 1, 2, -1, 1, 0) ≈ 1/√2
        1     @test fCGspin(-1, 1, 0) ≈ fCG(1, 1, 0, -1, 1, 0) ≈ -1/√2
        1     @test fCGspin(-1, -1, 1) ≈ fCG(1, 1, 2, -1, -1, -2) ≈ 1.0
        1     @test fCGspin(-1, -1, 0) ≈ fCG(1, 1, 0, -1, -1, -2) ≈ 0.0
        - end
        - 
        1 function test_CG3spin()
        1     wigner_init_float(3, "Jmax", 3)
        1     for ds1 = (-1, 1) for ds2 = (-1, 1) for ds3 = (-1, 1)
        8         for S12 = (0,1)
       16             for dS = (1,3)
       64                 x = fCG3spin(ds1, ds2, ds3, S12, dS)
       32                 y = fCG(1, 1, 2S12, ds1, ds2, ds1+ds2) * fCG(2S12, 1, dS, ds1+ds2, ds3, ds1+ds2+ds3)
       32                 @test x ≈ y
       48             end
       24         end
        8     end end end
        - end
        - 
        1 function test_3j_as_CG(test_range::AbstractArray)
       65     for dj1 in test_range, dj2 in test_range, dj3 in test_range
     3328         for dm1 in -dj1:2:dj1, dm2 in -dj2:2:dj2
    15488             dm3 = -dm1 - dm2
    15488             if check_couple(dj1, dj2, dj3) & check_jm(dj3, dm3)
     4318                 tj = d3j(dj1, dj2, dj3, dm1, dm2, dm3)
     4318                 cg = dCG(dj1, dj2, dj3, -dm1, -dm2, dm3)
     4318                 @test tj == cg * SqrtRational(iphase(dj1 + div(dj3 + dm3, 2)), 1//(dj3 + 1))
        -             end
    17792         end
      519     end
        1     wigner_init_float(cld(maximum(test_range), 2), "Jmax", 3)
       65     for dj1 in test_range, dj2 in test_range, dj3 in test_range
     3328         for dm1 in -dj1:2:dj1, dm2 in -dj2:2:dj2
    15488             dm3 = -dm1 - dm2
    15488             if check_couple(dj1, dj2, dj3) & check_jm(dj3, dm3)
     4318                 tj = f3j(dj1, dj2, dj3, dm1, dm2, dm3)
     4318                 cg = fCG(dj1, dj2, dj3, -dm1, -dm2, dm3)
     4318                 @test tj ≈ cg * iphase(dj1 + div(dj3 + dm3, 2)) / sqrt(dj3 + 1)
        -             end
    17792         end
      512     end
        - end
        - 
        - # test special condition for 6j symbols
        - # Ref[1], P299, Sec 9.5, Formula (1)
        1 function test_special_6j(test_range::AbstractArray)
      101     for j1 in test_range, j2 in test_range, j3 in test_range
     1000         if check_couple(Int(2j1), Int(2j2), Int(2j3))
      350             sj = sixJ(j1, j2, j3, j2, j1, 0)
      700             mysj = iphase(Int(j1 + j2 + j3)) / exact_sqrt((2j1 + 1) * (2j2 + 1))
      350             @test sj == mysj
        -         end
     1000     end
        - end
        - 
        - # test special condition for Racah coefficients
        - # Ref[1], P300, Sec 9.5, Formula (2)
        1 function test_special_Racah(test_range::AbstractArray)
      101     for j1 in test_range, j2 in test_range, j3 in test_range
     1000         if check_couple(Int(2j1), Int(2j2), Int(2j3))
      350             rc = Racah(0, j1, j2, j3, j1, j2)
      700             myrc = 1 / exact_sqrt((2j1 + 1) * (2j2 + 1))
      350             @test rc == myrc
        -         end
     1000     end
        - end
        - 
        - # test special condition for 9j symbols
        - # Ref[1], P357, Sec 10.9, Formula (1)
        1 function test_special_9j(test_range::AbstractArray)
     7777     for j1 in test_range, j2 in test_range, j3 in test_range,
        -         j4 in test_range, j5 in test_range, j7 in test_range
        - 
    46656         if check_6j(convert(Int, 2j1), convert(Int, 2j2), convert(Int, 2j3), convert(Int, 2j5), convert(Int, 2j4), convert(Int, 2j7))
     2853             nj = nineJ(j1, j2, j3, j4, j5, j3, j7, j7, 0)
     5706             snj = iphase(Int(j2 + j3 + j4 + j7)) / exact_sqrt((2j3 + 1) * (2j7 + 1))
     2853             snj *= sixJ(j1, j2, j3, j5, j4, j7)
     2853             @test nj == snj
        -         end
    46656     end
        - end
        - 
        1 function test_lsjj(test_range::AbstractArray)
        2     for l1 in test_range
       12         for l2 in test_range
       36             for L in abs(l1-l2):(l1+l2)
      146                 for (j1, j2) in [(l1+1//2, l2+1//2), (l1+1//2, l2-1//2), (l1-1//2, l2+1//2), (l1-1//2, l2-1//2)]
      584                     for (S, J) in [(0, L), (1, L-1), (1, L), (1, L+1)]
     2336                         @test lsjj(l1, l2, j1, j2, L, S, J) == norm9J(l1, 1//2, j1, l2, 1//2, j2, L, S, J)
     2336                     end
      584                 end
      256             end
       66         end
        6     end
        - end
        - 
        1 function test_flsjj(test_range::AbstractArray)
        1     wigner_init_float(maximum(test_range), "Jmax", 9)
        2     for l1 in test_range
       12         for l2 in test_range
       36             for L in abs(l1-l2):(l1+l2)
      146                 for (dj1, dj2) in [(2l1+1, 2l2+1), (2l1+1, 2l2-1), (2l1-1, 2l2+1), (2l1-1, 2l2-1)]
      584                     for (S, J) in [(0, L), (1, L-1), (1, L), (1, L+1)]
     2336                         @test flsjj(l1, l2, dj1, dj2, L, S, J) ≈ fnorm9j(2l1, 1, dj1, 2l2, 1, dj2, 2L, 2S, 2J)
     2336                     end
      584                 end
      256             end
       66         end
        6     end
        - end
