        - # show
        9 Base.show(io::IO, ::MIME"text/plain", x::SqrtRational) = begin
        9     if isone(x.r)
        3         if denominator(x.s) == 1
        2             print(io, numerator(x.s))
        -         else
        1             print(io, x.s)
        -         end
        3         return
        6     elseif isone(x.s)
        2         if denominator(x.r) == 1
        1             print(io, "√$(numerator(x.r))")
        -         else
        1             print(io, "√($(x.r))")
        -         end
        2         return
        4     elseif isone(-x.s)
        2         if denominator(x.r) == 1
        1             print(io, "-√$(numerator(x.r))")
        -         else
        1             print(io, "-√($(x.r))")
        -         end
        2         return
        -     end
        2     to_show::String = ""
        2     if denominator(x.s) == 1
        1         to_show = string(numerator(x.s))
        -     else
        1         to_show = "$(x.s)"
        -     end
        2     if denominator(x.r) == 1
        1         to_show *= "√$(numerator(x.r))"
        -     else
        1         to_show *= "√($(x.r))"
        -     end
        2     print(io, to_show)
        - end
        - 
        9 Base.show(io::IO, x::SqrtRational) = show(io::IO, "text/plain", x)
        - 
        9 Base.show(io::IO, ::MIME"text/markdown", x::SqrtRational) = begin
        9     if isone(x.r)
        3         if denominator(x.s) == 1
        2             show(io, "text/markdown", Markdown.parse("``$(numerator(x.s))``"))
        -         else
        1             show(io, "text/markdown", Markdown.parse("``\\frac{$(numerator(x.s))}{$(denominator(x.s))}``"))
        -         end
        3         return
        6     elseif isone(x.s)
        2         if denominator(x.r) == 1
        1             show(io, "text/markdown", Markdown.parse("``\\sqrt{$(numerator(x.r))}``"))
        -         else
        1             show(io, "text/markdown", Markdown.parse("``\\sqrt{\\frac{$(numerator(x.r))}{$(denominator(x.r))}}``"))
        -         end
        2         return
        4     elseif isone(-x.s)
        2         if denominator(x.r) == 1
        1             show(io, "text/markdown", Markdown.parse("``-\\sqrt{$(numerator(x.r))}``"))
        -         else
        1             show(io, "text/markdown", Markdown.parse("``-\\sqrt{\\frac{$(numerator(x.r))}{$(denominator(x.r))}}``"))
        -         end
        2         return
