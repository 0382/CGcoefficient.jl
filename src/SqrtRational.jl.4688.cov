        - """
        -     simplify(n::Integer)
        - Simplify a integer `n = x * t^2` to `(x, t)`
        - """
     4675 function simplify(n::Integer)
     4675     s = sign(n)
     4675     n = s * n
     4675     x = one(n)
     4675     t = one(n)
     4675     for (f, i) in factor(n)
     5632         ti, xi = divrem(i, 2)
     5632         xi == 1 && (x = x * f)
     5632         ti != 0 && (t = t * f^ti)
     5632     end
     4675     return s * x, t
        - end
        - 
     4050 function simplify(n::BigInt)
     4050     sb = signbit(n)
     4050     x = one(BigInt)
     4050     t = one(BigInt)
     4050     for (f, i) in factor(abs(n))
     2964         ti, xi = divrem(i, 2)
     2964         xi == 1 && MPZ.mul!(x, f)
     2964         ti != 0 && MPZ.mul_ui!(t, MPZ.pow_ui!(f, ti))
     2964     end
     4050     sb && MPZ.neg!(x)
     4050     return x, t
        - end
        - 
        - """
        -     simplify(x::SqrtRational)
        - Simplify a SqrtRational.
        - """
     4362 function simplify(x::SqrtRational)
     4362     nx, nt = simplify(numerator(x.r))
     4362     dx, dt = simplify(denominator(x.r))
     4362     nt *= numerator(x.s)
     4362     dt *= denominator(x.s)
     6200     a0 = gcd(nt, dt)
     4362     nt = div(nt, a0)
     4362     dt = div(dt, a0)
     6699     a1 = gcd(nx, dt)
     6699     a2 = gcd(dx, nt)
     4362     dt = div(dt, a1)
     4362     nt = div(nt, a2)
     4362     dx = div(dx, a2) * a1
     4362     nx = div(nx, a1) * a2
     4362     return SqrtRational(nt // dt, nx // dx)
        - end
