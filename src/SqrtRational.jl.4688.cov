        - """
        -     SqrtRational <: Real
        - Store exact value of a `Rational`'s square root.
        - It is stored in `s√r` format, and we do not simplify it during arithmetics.
        - You can use the `simplify` function to simplify it.
        - """
        - struct SqrtRational{T} <: Real
        -     s::Rational{T}
        -     r::Rational{T}
   493929     SqrtRational{T}(s::Rational{T}, r::Rational{T}) where {T} = begin
   640027         r < 0 && throw(ArgumentError("invalid SqrtRational $s√$r"))
   655676         (iszero(s) || iszero(r)) && return new(zero(s), one(r))
   341064         new(s, r)
        -     end
        - end
        - 
   706103 SqrtRational(s::Rational{T1}, r::Rational{T2}) where {T1,T2} = SqrtRational{promote_type(T1, T2)}(promote(s, r)...)
     8636 SqrtRational(s::Integer, r::Rational{T}) where {T} = SqrtRational(promote(s, r)...)
        1 SqrtRational(s::Rational{T}, r::Integer) where {T} = SqrtRational(promote(s, r)...)
   183034 SqrtRational(s::Integer, r::Integer) = SqrtRational(promote(Rational(s), r)...)
    85400 SqrtRational(s::Union{Integer,Rational}) = SqrtRational(s, one(s))
        - 
        - """
        -     exact_sqrt(r::Union{Integer, Rational})
        - Get exact `√r` using `SqrtRational` type.
        - """
   102165 exact_sqrt(r::Union{Integer,Rational}) = SqrtRational(one(r), r)
        - 
        - # some basic functions
    96345 Base.zero(::Type{SqrtRational{T}}) where {T} = SqrtRational(zero(T), one(T))
        7 Base.one(::Type{SqrtRational{T}}) where {T} = SqrtRational(one(T), one(T))
        6 Base.zero(x::SqrtRational) = zero(typeof(x))
        7 Base.one(x::SqrtRational) = one(typeof(x))
        3 Base.sign(x::SqrtRational) = sign(x.s)
        3 Base.signbit(x::SqrtRational) = signbit(x.s)
        2 Base.inv(x::SqrtRational) = SqrtRational(inv(x.s), inv(x.r))
        1 Base.copy(x::SqrtRational) = SqrtRational(deepcopy(x.s), deepcopy(x.r))
        - 
        - # override some operators
        2 +(x::SqrtRational) = x
       14 -(x::SqrtRational) = SqrtRational(-x.s, x.r)
   151542 *(x::SqrtRational, y::SqrtRational) = SqrtRational(x.s * y.s, x.r * y.r)
    39644 *(x::SqrtRational, y::Union{Integer,Rational}) = SqrtRational(x.s * y, x.r)
       12 *(x::Union{Integer,Rational}, y::SqrtRational) = y * x
    38993 /(x::SqrtRational, y::SqrtRational) = SqrtRational(x.s / y.s, x.r / y.r)
        1 /(x::SqrtRational, y::Union{Integer,Rational}) = SqrtRational(x.s / y, x.r)
     7566 /(x::Union{Integer,Rational}, y::SqrtRational) = SqrtRational(x / y.s, inv(y.r))
   126079 ==(x::SqrtRational, y::SqrtRational) = begin
   126081     if y.s == 0
   108806         return x.s == 0
    17275     elseif signbit(y.s) != signbit(x.s)
        1         return false
        -     else
    17274         isone((x.s / y.s)^2 * (x.r / y.r))
        -     end
        - end
    66313 ==(x::SqrtRational, y::Union{Integer,Rational}) = (x == SqrtRational(y))
        2 ==(x::Union{Integer,Rational}, y::SqrtRational) = (SqrtRational(x) == y)
        - 
        - # Only if `r == 1` in `s√r`, the add operator can work.
        - # We do not simplify `s√r` every time, but in this function,
        - # we need to simplify it first, and then do the `+` operator.
    38990 +(x::SqrtRational, y::Union{Integer,Rational}) = begin
    38993     r = x.r
    38993     t1 = isqrt(numerator(r))
    38993     t1 * t1 != numerator(r) && throw(ArgumentError("cannot simplify $(x)"))
    38993     t2 = isqrt(denominator(r))
    38993     t2 * t2 != denominator(r) && throw(ArgumentError("cannot simplify $(x)"))
    38993     return x.s * (t1 // t2) + y
        - end
    38993 +(x::Union{Integer,Rational}, y::SqrtRational) = y + x
    50418 +(x::SqrtRational{T1}, y::SqrtRational{T2}) where {T1,T2} = begin
    50420     if x == 0
    11428         return y
        -     else
    38992         return x * (one(promote_type(T1, T2)) + y / x)
        -     end
        - end
        - -(x::SqrtRational, y::Union{Integer,Rational}) = (x + (-y))
        1 -(x::Union{Integer,Rational}, y::SqrtRational) = (x + (-y))
        2 -(x::SqrtRational, y::SqrtRational) = (x + (-y))
        - 
        - # widen
        - Base.widen(x::SqrtRational) = SqrtRational(widen(x.s), widen(x.r))
        - 
        - # convert
        - """
        -     float(x::SqrtRational{T})::float(T)
        - Convert a `SqrtRational` to float.
        - """
        - Base.float(x::SqrtRational) = float(x.s) * sqrt(float(x.r))
        - 
        - Base.convert(::Type{Float64}, x::SqrtRational{BigInt}) = begin
        -     sn, esn = __gmpz_get_d_2exp!(x.s.num)
        -     sd, esd = __gmpz_get_d_2exp!(x.s.den)
        -     rn, ern = __gmpz_get_d_2exp!(x.r.num)
        -     rd, erd = __gmpz_get_d_2exp!(x.r.den)
        -     exp2 = 2 * (esn - esd) + ern - erd
        -     oexp = exp2 & 1
        -     exp2 = div(exp2 - oexp, 2)
        -     if oexp == 1
        -         rn = ldexp(rn, 1)
        -     end
        -     v = float(sn/sd) * sqrt(float(rn/rd))
        -     v = ldexp(v, exp2)
        -     return v
        - end
