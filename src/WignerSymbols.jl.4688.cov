        - # basic 3j-symbol calculation funciton
    98270 function _d3j(dj1::Int, dj2::Int, dj3::Int, dm1::Int, dm2::Int, dm3::Int)
   149036     check_3j(dj1, dj2, dj3, dm1, dm2, dm3) || return zero(SqrtRational{BigInt})
    47504     J::Int = div(dj1 + dj2 + dj3, 2)
    47504     Jm1::Int = J - dj1
    47504     Jm2::Int = J - dj2
    47504     Jm3::Int = J - dj3
    47504     j1mm1::Int = div(dj1 - dm1, 2)
    47504     j2mm2::Int = div(dj2 - dm2, 2)
    47504     j3mm3::Int = div(dj3 - dm3, 2)
    47504     j1pm1::Int = div(dj1 + dm1, 2)
    47504     t = BigInt()
    47504     nA = _bigbin(dj1, Jm2)
    47504     MPZ.mul!(nA, _bigbin(t, dj2, Jm1))
    47504     dA = _bigbin(J, Jm3)
    47504     MPZ.mul!(dA, _bigbin(t, dj1, j1mm1))
    47504     MPZ.mul!(dA, _bigbin(t, dj2, j2mm2))
    47504     MPZ.mul!(dA, _bigbin(t, dj3, j3mm3))
    47504     MPZ.mul_ui!(dA, convert(Culong, J + 1))
        - 
    47504     B::BigInt = zero(BigInt)
    47504     low::Int = max(zero(Int), j1pm1 - Jm2, j2mm2 - Jm1)
    47504     high::Int = min(Jm3, j1pm1, j2mm2)
    47504     tz = BigInt()
    47504     for z in low:high
   125487         _bigbin(tz, Jm3, z)
   125487         MPZ.mul!(tz, _bigbin(t, Jm2, j1pm1 - z))
   125487         MPZ.mul!(tz, _bigbin(t, Jm1, j2mm2 - z))
   125487         MPZ.sub!(B, tz, B)
   203470     end
    47504     if isodd(dj1 + div(dj3 + dm3, 2) + high)
    23949         MPZ.neg!(B)
        -     end
    47504     simplify3!(t, B, nA, dA, J + 1)
    47504     return SqrtRational(Base.unsafe_rational(B, t), Base.unsafe_rational(nA, dA))
        - end
