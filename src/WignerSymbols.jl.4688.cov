        - # spaecial case: m1 == m2 == m3 == 0
      640 function _CG0(j1::Int, j2::Int, j3::Int)
      930     check_couple(j1, j2, j3) || return zero(SqrtRational{BigInt})
      350     J = j1 + j2 + j3
      350     g = div(J, 2)
      350     sn = _bigbin(g, j3)
      350     sd = _bigbin(j3, g - j1)
      350     MPZ.mul!(sn, sd)
      350     if isodd(g - j3)
      169         MPZ.neg!(sn)
        -     end
      350     rd = _bigbin(J + 1, 2j3 + 1)
      350     rn = _bigbin(2j3, J - 2j1)
      350     MPZ.mul!(rd, rn)
      350     simplify2!(sn, sd, rn, rd, J + 1)
      350     return SqrtRational(Base.unsafe_rational(sn, sd), Base.unsafe_rational(rn, rd))
        - end
