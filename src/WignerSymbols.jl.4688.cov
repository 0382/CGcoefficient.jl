        - # basic CG coefficient calculation function
   105385 function _dCG(dj1::Int, dj2::Int, dj3::Int, dm1::Int, dm2::Int, dm3::Int)
   105391     check_CG(dj1, dj2, dj3, dm1, dm2, dm3) || return zero(SqrtRational{BigInt})
   105385     J::Int = div(dj1 + dj2 + dj3, 2)
   105385     Jm1::Int = J - dj1
   105385     Jm2::Int = J - dj2
   105385     Jm3::Int = J - dj3
   105385     j1mm1::Int = div(dj1 - dm1, 2)
   105385     j2mm2::Int = div(dj2 - dm2, 2)
   105385     j3mm3::Int = div(dj3 - dm3, 2)
   105385     j2pm2::Int = div(dj2 + dm2, 2)
   105385     t = BigInt()
   105385     nA = _bigbin(dj1, Jm2)
   105385     MPZ.mul!(nA, _bigbin(t, dj2, Jm3))
   105385     dA = _bigbin(J + 1, Jm3)
   105385     MPZ.mul!(dA, _bigbin(t, dj1, j1mm1))
   105385     MPZ.mul!(dA, _bigbin(t, dj2, j2mm2))
   105385     MPZ.mul!(dA, _bigbin(t, dj3, j3mm3))
        - 
   105385     B::BigInt = zero(BigInt)
   105385     low::Int = max(zero(Int), j1mm1 - Jm2, j2pm2 - Jm1)
   105385     high::Int = min(Jm3, j1mm1, j2pm2)
   105385     tz = BigInt()
   105385     for z in low:high
   155047         _bigbin(tz, Jm3, z)
   155047         MPZ.mul!(tz, _bigbin(t, Jm2, j1mm1 - z))
   155047         MPZ.mul!(tz, _bigbin(t, Jm1, j2pm2 - z))
   155047         MPZ.sub!(B, tz, B)
   204709     end
   105385     if isodd(high)
    42633         MPZ.neg!(B)
        -     end
   105385     simplify3!(t, B, nA, dA, J + 1)
   105385     return SqrtRational(Base.unsafe_rational(B, t), Base.unsafe_rational(nA, dA))
        - end
