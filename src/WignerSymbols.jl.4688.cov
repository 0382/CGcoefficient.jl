    46656 function _xGaunt(l1::Int, l2::Int, l3::Int, m1::Int, m2::Int, m3::Int)
    91379     check_Gaunt(l1, l2, l3, m1, m2, m3) || return zero(SqrtRational{BigInt})
     1935     J::Int = l1 + l2 + l3
     1935     g::Int = div(J, 2)
     1935     Jm1::Int = l2 + l3 - l1
     1935     Jm2::Int = l1 + l3 - l2
     1935     Jm3::Int = l1 + l2 - l3
     1935     j1mm1::Int = l1 - m1
     1935     j2mm2::Int = l2 - m2
     1935     j3mm3::Int = l3 - m3
     1935     j1pm1::Int = l1 + m1
        - 
     1935     sn = zero(BigInt)
     1935     sd = zero(BigInt)
     1935     temp = zero(BigInt)
     1935     low = max(zero(Int), j1pm1 - Jm2, j2mm2 - Jm1)
     1935     high = min(Jm3, j1pm1, j2mm2)
     1935     for z in low:high
     2895         _bigbin(sd, Jm3, z)
     2895         MPZ.mul!(sd, _bigbin(temp, Jm2, j1pm1 - z))
     2895         MPZ.mul!(sd, _bigbin(temp, Jm1, j2mm2 - z))
     2895         MPZ.sub!(sn, sd, sn)
     3855     end
     1935     if iszero(sn)
       30         return zero(SqrtRational{BigInt})
        -     end
     1905     if isodd(g + j3mm3 + high)
      949         MPZ.neg!(sn)
        -     end
     1905     MPZ.mul!(sn, _bigbin(temp, g, g - l3))
     1905     MPZ.mul!(sn, _bigbin(temp, l3, g - l1))
     1905     rn = zero(BigInt)
     1905     rd = zero(BigInt)
     1905     MPZ.set_ui!(rd, 4)
     1905     MPZ.mul!(rd, _bigbin(temp, 2l1, j1mm1))
     1905     MPZ.mul!(rd, _bigbin(temp, 2l2, j2mm2))
     1905     MPZ.mul!(rd, _bigbin(temp, 2l3, j3mm3))
     1905     MPZ.set_ui!(rn, convert(Culong, 2l3 + 1))
     1905     MPZ.mul!(rn, _bigbin(temp, 2l3, Jm1))
     1905     MPZ.mul!(rd, _bigbin(temp, J + 1, 2l1 + 1))
     1905     MPZ.mul!(rd, _bigbin(temp, J + 1, 2l2 + 1))
     1905     simplify3!(sd, sn, rn, rd, J + 1)
     1905     return SqrtRational(Base.unsafe_rational(sn, sd), Base.unsafe_rational(rn, rd))
        - end
