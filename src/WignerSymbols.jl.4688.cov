        - # basic 9j-symbol calculation funciton
     5190 function _d9j(dj1::Int, dj2::Int, dj3::Int, dj4::Int, dj5::Int, dj6::Int, dj7::Int, dj8::Int, dj9::Int)
     5640     check_9j(dj1, dj2, dj3, dj4, dj5, dj6, dj7, dj8, dj9) || return zero(SqrtRational{BigInt})
     4746     j123::Int = div(dj1 + dj2 + dj3, 2)
     4746     j456::Int = div(dj4 + dj5 + dj6, 2)
     4746     j789::Int = div(dj7 + dj8 + dj9, 2)
     4746     j147::Int = div(dj1 + dj4 + dj7, 2)
     4746     j258::Int = div(dj2 + dj5 + dj8, 2)
     4746     j369::Int = div(dj3 + dj6 + dj9, 2)
     4746     pm123::Int = div(dj1 + dj2 - dj3, 2)
     4746     pm132::Int = div(dj1 + dj3 - dj2, 2)
     4746     pm231::Int = div(dj2 + dj3 - dj1, 2)
     4746     pm456::Int = div(dj4 + dj5 - dj6, 2)
     4746     pm465::Int = div(dj4 + dj6 - dj5, 2)
     4746     pm564::Int = div(dj5 + dj6 - dj4, 2)
     4746     pm789::Int = div(dj7 + dj8 - dj9, 2)
     4746     pm798::Int = div(dj7 + dj9 - dj8, 2)
     4746     pm897::Int = div(dj8 + dj9 - dj7, 2)
     4746     dtl = max(abs(dj2 - dj6), abs(dj4 - dj8), abs(dj1 - dj9))
     4746     dth = min(dj2 + dj6, dj4 + dj8, dj1 + dj9)
     4746     sum = zero(BigInt)
     4746     ABC = zero(BigInt)
     4746     Pt = zero(BigInt)
     4746     tx = zero(BigInt)
     4746     temp = zero(BigInt)
     5947     for dt = dtl:2:dth
     5952         j19t = div(dj1 + dj9 + dt, 2)
     5952         j26t = div(dj2 + dj6 + dt, 2)
     5952         j48t = div(dj4 + dj8 + dt, 2)
     5952         MPZ.set_ui!(ABC, convert(Culong, dt + 1))
     5952         xl = max(j123, j369, j26t, j19t)
     5952         xh = min(pm123 + j369, pm132 + j26t, pm231 + j19t)
     5952         MPZ.set_ui!(Pt, 0)
     5952         for x = xl:xh
     5961             _bigbin(tx, x + 1, j19t + 1)
     5961             MPZ.mul!(tx, _bigbin(temp, div(dj1 + dj9 - dt, 2), x - j26t))
     5961             MPZ.mul!(tx, _bigbin(temp, div(dj1 + dt - dj9, 2), x - j369))
     5961             MPZ.mul!(tx, _bigbin(temp, div(dt + dj9 - dj1, 2), x - j123))
     5961             MPZ.sub!(Pt, tx, Pt)
     5970         end
     5952         MPZ.mul!(ABC, Pt)
     5952         yl = max(j456, j26t, j258, j48t)
     5952         yh = min(pm456 + j26t, pm465 + j258, pm564 + j48t)
     5952         MPZ.set_ui!(Pt, 0)
     5952         for y = yl:yh
     6579             _bigbin(tx, y + 1, j26t + 1)
     6579             MPZ.mul!(tx, _bigbin(temp, div(dj2 + dj6 - dt, 2), y - j48t))
     6579             MPZ.mul!(tx, _bigbin(temp, div(dj6 + dt - dj2, 2), y - j258))
     6579             MPZ.mul!(tx, _bigbin(temp, div(dt + dj2 - dj6, 2), y - j456))
     6579             MPZ.sub!(Pt, tx, Pt)
     7206         end
     5952         MPZ.mul!(ABC, Pt)
     5952         zl = max(j789, j19t, j48t, j147)
     5952         zh = min(pm789 + j19t, pm798 + j48t, pm897 + j147)
     5952         MPZ.set_ui!(Pt, 0)
     5952         for z = zl:zh
     6301             _bigbin(tx, z + 1, j48t + 1)
     6301             MPZ.mul!(tx, _bigbin(temp, div(dj4 + dj8 - dt, 2), z - j19t))
     6301             MPZ.mul!(tx, _bigbin(temp, div(dj8 + dt - dj4, 2), z - j147))
     6301             MPZ.mul!(tx, _bigbin(temp, div(dt + dj4 - dj8, 2), z - j789))
     6301             MPZ.sub!(Pt, tx, Pt)
     6650         end
     5952         MPZ.mul!(ABC, Pt)
     5952         if isodd(xh + yh + zh)
     2322             MPZ.neg!(ABC)
        -         end
     5952         MPZ.add!(sum, ABC)
     7158     end
     4746     if iszero(sum)
       66         return zero(SqrtRational{BigInt})
        -     end
     4680     if isodd(dth)
     1344         MPZ.neg!(sum)
        -     end
     4680     MPZ.set_ui!(Pt, convert(Culong, dj3 + 1))
     4680     MPZ.mul_ui!(Pt, convert(Culong, dj6 + 1))
     4680     MPZ.mul_ui!(Pt, convert(Culong, dj9 + 1))
     4680     MPZ.mul_ui!(Pt, convert(Culong, dj7 + 1))
     4680     MPZ.mul_ui!(Pt, convert(Culong, dj8 + 1))
     4680     MPZ.mul_ui!(Pt, convert(Culong, dj9 + 1))
     4680     MPZ.mul!(Pt, _bigbin(temp, j123 + 1, dj3 + 1))
     4680     MPZ.mul!(Pt, _bigbin(temp, j456 + 1, dj6 + 1))
     4680     MPZ.mul!(Pt, _bigbin(temp, j789 + 1, dj9 + 1))
     4680     MPZ.mul!(Pt, _bigbin(temp, dj3, pm231))
     4680     MPZ.mul!(Pt, _bigbin(temp, dj6, pm564))
     4680     MPZ.mul!(Pt, _bigbin(temp, dj9, pm897))
     4680     MPZ.mul!(Pt, _bigbin(temp, j147 + 1, dj7 + 1))
     4680     MPZ.mul!(Pt, _bigbin(temp, j258 + 1, dj8 + 1))
     4680     MPZ.mul!(Pt, _bigbin(temp, j369 + 1, dj9 + 1))
     4680     MPZ.mul!(Pt, _bigbin(temp, dj7, div(dj7 - dj1 + dj4, 2)))
     4680     MPZ.mul!(Pt, _bigbin(temp, dj8, div(dj8 - dj2 + dj5, 2)))
     4680     MPZ.mul!(Pt, _bigbin(temp, dj9, div(dj9 - dj3 + dj6, 2)))
     4680     Jmax = max(j123, j456, j789, j147, j258, j369)
     4680     simplify2!(sum, tx, ABC, Pt, Jmax + 1)
     4680     return SqrtRational(Base.unsafe_rational(sum, tx), Base.unsafe_rational(ABC, Pt))
        - end
