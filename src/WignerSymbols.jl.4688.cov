        - # basic 6j-symbol calculation funciton
     5580 function _d6j(dj1::Int, dj2::Int, dj3::Int, dj4::Int, dj5::Int, dj6::Int)
     5584     check_6j(dj1, dj2, dj3, dj4, dj5, dj6) || return zero(SqrtRational{BigInt})
     5580     j123::Int = div(dj1 + dj2 + dj3, 2)
     5580     j156::Int = div(dj1 + dj5 + dj6, 2)
     5580     j426::Int = div(dj4 + dj2 + dj6, 2)
     5580     j453::Int = div(dj4 + dj5 + dj3, 2)
     5580     jpm123::Int = div(dj1 + dj2 - dj3, 2)
     5580     jpm132::Int = div(dj1 + dj3 - dj2, 2)
     5580     jpm231::Int = div(dj2 + dj3 - dj1, 2)
     5580     jpm156::Int = div(dj1 + dj5 - dj6, 2)
     5580     jpm426::Int = div(dj4 + dj2 - dj6, 2)
     5580     jpm453::Int = div(dj4 + dj5 - dj3, 2)
        -     # value in sqrt
     5580     t = BigInt()
     5580     nA = _bigbin(j123 + 1, dj1 + 1)
     5580     MPZ.mul!(nA, _bigbin(t, dj1, jpm123))
     5580     dA = _bigbin(j156 + 1, dj1 + 1)
     5580     MPZ.mul!(dA, _bigbin(t, dj1, jpm156))
     5580     MPZ.mul!(dA, _bigbin(t, j453 + 1, dj4 + 1))
     5580     MPZ.mul!(dA, _bigbin(t, dj4, jpm453))
     5580     MPZ.mul!(dA, _bigbin(t, j426 + 1, dj4 + 1))
     5580     MPZ.mul!(dA, _bigbin(t, dj4, jpm426))
     5580     MPZ.mul_ui!(dA, convert(Culong, dj4 + 1))
     5580     MPZ.mul_ui!(dA, convert(Culong, dj4 + 1))
     5580     B::BigInt = zero(BigInt)
     5580     low::Int = max(j123, j453, j426, j156)
     5580     high::Int = min(jpm123 + j453, jpm132 + j426, jpm231 + j156)
     5580     tx = BigInt()
     5580     for x = low:high
     8500         _bigbin(t, x + 1, j123 + 1)
     8500         MPZ.mul!(t, _bigbin(tx, jpm123, x - j453))
     8500         MPZ.mul!(t, _bigbin(tx, jpm132, x - j426))
     8500         MPZ.mul!(t, _bigbin(tx, jpm231, x - j156))
     8500         MPZ.sub!(B, t, B)
    11420     end
     5580     if isodd(high)
     2753         MPZ.neg!(B)
        -     end
     5580     simplify3!(t, B, nA, dA, high + 1)
     5580     return SqrtRational(Base.unsafe_rational(B, t), Base.unsafe_rational(nA, dA))
        - end
