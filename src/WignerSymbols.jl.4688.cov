        - function _m9j!(
        -     sum::BigInt, temp::BigInt, tx::BigInt, Pt::BigInt, ABC::BigInt,
        -     j1::Int, j2::Int, j3::Int, j4::Int, j5::Int, j6::Int, j7::Int, j8::Int, j9::Int)
        -     j123::Int = j1 + j2 + j3
        -     j456::Int = j4 + j5 + j6
        -     j789::Int = j7 + j8 + j9
        -     j147::Int = j1 + j4 + j7
        -     j258::Int = j2 + j5 + j8
        -     j369::Int = j3 + j6 + j9
        -     pm123::Int = j1 + j2 - j3
        -     pm132::Int = j1 + j3 - j2
        -     pm231::Int = j2 + j3 - j1
        -     pm456::Int = j4 + j5 - j6
        -     pm465::Int = j4 + j6 - j5
        -     pm564::Int = j5 + j6 - j4
        -     pm789::Int = j7 + j8 - j9
        -     pm798::Int = j7 + j9 - j8
        -     pm897::Int = j8 + j9 - j7
        -     MPZ.set_ui!(sum, 0)
        -     tl::Int = max(abs(j2 - j6), abs(j4 - j8), abs(j1 - j9))
        -     th::Int = min(j2 + j6, j4 + j8, j1 + j9)
        -     for t::Int = tl:th
        -         j19t::Int = j1 + j9 + t
        -         j26t::Int = j2 + j6 + t
        -         j48t::Int = j4 + j8 + t
        -         MPZ.set_ui!(ABC, convert(Culong, 2t + 1))
        -         xl::Int = max(j123, j369, j26t, j19t)
        -         xh::Int = min(pm123 + j369, pm132 + j26t, pm231 + j19t)
        -         MPZ.set_ui!(Pt, 0)
        -         for x = xl:xh
        -             _bigbin(tx, x + 1, j19t + 1)
        -             MPZ.mul!(tx, _bigbin(temp, j1 + j9 - t, x - j26t))
        -             MPZ.mul!(tx, _bigbin(temp, j1 + t - j9, x - j369))
        -             MPZ.mul!(tx, _bigbin(temp, t + j9 - j1, x - j123))
        -             MPZ.sub!(Pt, tx, Pt)
        -         end
        -         MPZ.mul!(ABC, Pt)
        -         yl::Int = max(j456, j26t, j258, j48t)
        -         yh::Int = min(pm456 + j26t, pm465 + j258, pm564 + j48t)
        -         MPZ.set_ui!(Pt, 0)
        -         for y = yl:yh
        -             _bigbin(tx, y + 1, j26t + 1)
        -             MPZ.mul!(tx, _bigbin(temp, j2 + j6 - t, y - j48t))
        -             MPZ.mul!(tx, _bigbin(temp, j6 + t - j2, y - j258))
        -             MPZ.mul!(tx, _bigbin(temp, t + j2 - j6, y - j456))
        -             MPZ.sub!(Pt, tx, Pt)
        -         end
        -         MPZ.mul!(ABC, Pt)
        -         zl::Int = max(j789, j19t, j48t, j147)
        -         zh::Int = min(pm789 + j19t, pm798 + j48t, pm897 + j147)
        -         MPZ.set_ui!(Pt, 0)
        -         for z = zl:zh
        -             _bigbin(tx, z + 1, j48t + 1)
        -             MPZ.mul!(tx, _bigbin(temp, j4 + j8 - t, z - j19t))
        -             MPZ.mul!(tx, _bigbin(temp, j8 + t - j4, z - j147))
        -             MPZ.mul!(tx, _bigbin(temp, t + j4 - j8, z - j789))
        -             MPZ.sub!(Pt, tx, Pt)
        -         end
        -         MPZ.mul!(ABC, Pt)
        -         if isodd(xh + yh + zh)
        -             MPZ.neg!(ABC)
        -         end
        -         MPZ.add!(sum, ABC)
        -     end
        -     return
        - end
        - 
        - # D = \tan^2\beta = (m_1\omega_1)/(m_2\omega_2)
        - function _Moshinsky(N::Int, L::Int, n::Int, l::Int, n1::Int, l1::Int, n2::Int, l2::Int, Λ::Int, numD::Int, denD::Int)
        4     check_Moshinsky(N, L, n, l, n1, l1, n2, l2, Λ) || return zero(SqrtRational{BigInt})
        0     e1 = 2 * n1 + l1
        0     e2 = 2 * n2 + l2
        0     E = 2 * N + L
        0     e = 2 * n + l
        0     χ = e1 + e2
        0     nl1 = n1 + l1
        0     nl2 = n2 + l2
        0     NL = N + L
        0     nl = n + l
        - 
        0     temp = BigInt()
        0     tx = BigInt()
        0     Pt = BigInt()
        0     ABC = BigInt()
        0     nu_a = BigInt()
        0     de_a = BigInt()
        0     nu_b = BigInt()
        0     de_b = BigInt()
        0     nu_c = BigInt()
        0     de_c = BigInt()
        0     nu_d = BigInt()
        0     de_d = BigInt()
        0     nu_fa = BigInt()
        0     de_fa = BigInt()
        0     M9j = BigInt()
        - 
        0     Snu = BigInt()
        0     Sde = BigInt()
        - 
        0     _bigbin(Snu, χ + 2, e1 + 1)
        0     _bigbin(Sde, χ + 2, E + 1)
        0     MPZ.mul!(Sde, _bigbin(temp, L + l + Λ + 1, 2Λ + 1))
        0     MPZ.mul!(Sde, _bigbin(temp, 2Λ, Λ + L - l))
        0     MPZ.mul!(Sde, _bigbin(temp, l1 + l2 + Λ + 1, 2Λ + 1))
        0     MPZ.mul!(Sde, _bigbin(temp, 2Λ, Λ + l1 - l2))
        0     _divgcd!(temp, Snu, Sde)
        - 
        0     MPZ.mul!(Snu, _bigbin(temp, 2nl1 + 1, nl1))
        0     MPZ.mul_ui!(Sde, convert(Culong, 2l1 + 1))
        0     MPZ.mul!(Sde, _bigbin(temp, e1 + 1, n1))
        - 
        0     MPZ.mul!(Snu, _bigbin(temp, 2nl2 + 1, nl2))
        0     MPZ.mul_ui!(Sde, convert(Culong, 2l2 + 1))
        0     MPZ.mul!(Sde, _bigbin(temp, e2 + 1, n2))
        - 
        0     MPZ.mul!(Snu, _bigbin(temp, 2NL + 1, NL))
        0     MPZ.mul_ui!(Sde, convert(Culong, 2L + 1))
        0     MPZ.mul!(Sde, _bigbin(temp, E + 1, N))
        - 
        0     MPZ.mul!(Snu, _bigbin(temp, 2nl + 1, nl))
        0     MPZ.mul_ui!(Sde, convert(Culong, 2l + 1))
        0     MPZ.mul!(Sde, _bigbin(temp, e + 1, n))
        - 
        0     _divgcd!(temp, Snu, Sde)
        - 
        0     MPZ.set_ui!(tx, convert(Culong, e1 + 2))
        0     MPZ.mul_ui!(tx, convert(Culong, e2 + 2))
        0     MPZ.mul_ui!(tx, convert(Culong, 2Λ + 1))
        0     MPZ.pow_ui!(tx, 2)
        0     MPZ.mul_2exp!(tx, l1 + l2 + L + l)
        0     MPZ.mul!(Sde, tx)
        0     _divgcd!(temp, Snu, Sde)
        - 
        0     if e - e1 > 0
        0         __gmpz_ui_pow_ui!(temp, convert(Culong, numD), convert(Culong, e - e1))
        0         MPZ.mul!(Snu, temp)
        0     elseif e - e1 < 0
        0         __gmpz_ui_pow_ui!(temp, convert(Culong, numD), convert(Culong, e1 - e))
        0         MPZ.mul!(Sde, temp)
        -     end
        0     __gmpz_ui_pow_ui!(temp, convert(Culong, denD), convert(Culong, e1 + E))
        0     MPZ.mul!(Snu, temp)
        0     __gmpz_ui_pow_ui!(temp, convert(Culong, numD + denD), convert(Culong, e + E))
        0     MPZ.mul!(Sde, temp)
        0     _divgcd!(temp, Snu, Sde)
        - 
        0     sum = zero(Rational{BigInt})
        0     for ea = 0:min(e1, E)
        0         eb = e1 - ea
        0         ec = E - ea
        0         ed = e2 - ec
        0         ed < 0 && continue
        0         _bigbin(nu_fa, e1 + 2, ea + 1)
        0         MPZ.mul!(nu_fa, _bigbin(temp, e2 + 2, ec + 1))
        0         __gmpz_ui_pow_ui!(temp, convert(Culong, numD), convert(Culong, ea))
        0         MPZ.mul!(nu_fa, temp)
        0         __gmpz_ui_pow_ui!(de_fa, convert(Culong, denD), convert(Culong, ea))
        0         _divgcd!(temp, nu_fa, de_fa)
        0         for la = rem(ea, 2):2:ea
        0             na = div(ea - la, 2)
        0             nla = na + la
        0             MPZ.mul_ui!(nu_a, nu_fa, convert(Culong, 2la + 1))
        0             MPZ.mul!(nu_a, _bigbin(temp, ea + 1, na))
        0             MPZ.mul_2exp!(nu_a, la)
        0             MPZ.mul!(de_a, de_fa, _bigbin(temp, 2nla + 1, nla))
        0             _divgcd!(temp, nu_a, de_a)
        0             for lb = abs(l1 - la):2:min(l1 + la, eb)
        0                 nb = div(eb - lb, 2)
        0                 nlb = nb + lb
        0                 MPZ.mul_ui!(nu_b, nu_a, convert(Culong, 2lb + 1))
        0                 MPZ.mul!(nu_b, _bigbin(temp, eb + 1, nb))
        0                 MPZ.mul_2exp!(nu_b, lb)
        0                 MPZ.mul!(de_b, de_a, _bigbin(temp, 2nlb + 1, nlb))
        0                 MPZ.mul!(nu_b, _omega(tx, temp, la, l1, div(la + lb + l1, 2)))
        -                 # Δ(lalbl1)
        0                 MPZ.mul!(de_b, _bigbin(temp, la + lb + l1 + 1, 2l1 + 1))
        0                 MPZ.mul!(de_b, _bigbin(temp, 2l1, l1 + la - lb))
        0                 _divgcd!(temp, nu_b, de_b)
        0                 for lc = abs(L - la):2:min(L + la, ec)
        0                     nc = div(ec - lc, 2)
        0                     nlc = nc + lc
        0                     MPZ.mul_ui!(nu_c, nu_b, convert(Culong, 2lc + 1))
        0                     MPZ.mul!(nu_c, _bigbin(temp, ec + 1, nc))
        0                     MPZ.mul_2exp!(nu_c, lc)
        0                     MPZ.mul!(de_c, de_b, _bigbin(temp, 2nlc + 1, nlc))
        0                     MPZ.mul!(nu_c, _omega(tx, temp, la, L, div(la + lc + L, 2)))
        -                     # Δ(lalcl3)
        0                     MPZ.mul!(de_c, _bigbin(temp, la + lc + L + 1, 2L + 1))
        0                     MPZ.mul!(de_c, _bigbin(temp, 2L, L + la - lc))
        0                     _divgcd!(temp, nu_c, de_c)
        0                     ldmin = max(abs(l2 - lc), abs(l - lb))
        0                     ldmax = min(ed, l2 + lc, l + lb)
        0                     for ld = ldmin:2:ldmax
        0                         nd = div(ed - ld, 2)
        0                         nld = nd + ld
        0                         MPZ.mul_ui!(nu_d, nu_c, convert(Culong, 2ld + 1))
        0                         MPZ.mul!(nu_d, _bigbin(temp, ed + 1, nd))
        0                         MPZ.mul_2exp!(nu_d, ld)
        0                         MPZ.mul!(de_d, de_c, _bigbin(temp, 2nld + 1, nld))
        0                         MPZ.mul!(nu_d, _omega(tx, temp, lc, l2, div(lc + ld + l2, 2)))
        0                         MPZ.mul!(nu_d, _omega(tx, temp, lb, l, div(lb + ld + l, 2)))
        -                         # Δ(lbldl4)
        0                         MPZ.mul!(de_d, _bigbin(temp, lb + ld + l + 1, 2l + 1))
        0                         MPZ.mul!(de_d, _bigbin(temp, 2l, l + lb - ld))
        -                         # Δ(lcldl2)
        0                         MPZ.mul!(de_d, _bigbin(temp, lc + ld + l2 + 1, 2l2 + 1))
        0                         MPZ.mul!(de_d, _bigbin(temp, 2l2, l2 + lc - ld))
        0                         _divgcd!(temp, nu_d, de_d)
        0                         if isodd(ld)
        0                             MPZ.neg!(nu_d)
        -                         end
        0                         _m9j!(M9j, temp, tx, Pt, ABC, la, lb, l1, lc, ld, l2, L, l, Λ)
        -                         # don't use MPQ.add! to avoid memory allocation
        0                         MPZ.mul!(nu_d, M9j)
        0                         _divgcd!(temp, nu_d, de_d)
        0                         __gmpq_add!(tx, sum, nu_d, de_d)
        0                     end
        0                 end
        0             end
        0         end
        0     end
        0     simplify4!(tx, sum.num, sum.den, Snu, Sde, max(χ + 2, max(l1 + l2, L + l) + Λ + 1, numD + denD))
        0     return SqrtRational(sum, Base.unsafe_rational(Snu, Sde))
        - end
