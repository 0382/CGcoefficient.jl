     2336 function _lsjj(l1::Int, l2::Int, dj1::Int, dj2::Int, L::Int, S::Int, J::Int)::Rational{Int}
     2336     check_couple(2l1, 2l2, 2L) || return zero(Rational{Int})
     2769     check_couple(dj1, dj2, 2J) || return zero(Rational{Int})
     1903     LSJcase = 0
     1903     if S == 0
      506         LSJcase = 1
     1397     elseif S == 1
     1397         (L == J - 1) && (LSJcase = 2)
     1397         (J == L) && (LSJcase = 3)
     1397         (L == J + 1) && (LSJcase = 4)
        -     end
     1903     iszero(LSJcase) && return zero(Rational{Int})
     1903     m = l1 - l2
     1903     p = l1 + l2
     1903     δ1 = dj1 - 2l1
     1903     δ2 = dj2 - 2l2
     1903     d = 2 * (2l1 + 1) * (2l2 + 1)
     1903     r = zero(Rational{Int})
     1903     if δ1 == 1 && δ2 == 1
      548         if LSJcase == 1
      146             r = (J + p + 2) * (p + 1 - J) // d
      402         elseif LSJcase == 2
      146             r = (J + m) * (J - m) // (J * (2J + 1))
      146             r *= (J + p + 1) * (J + p + 2) // d
      256         elseif LSJcase == 3
      146             m == 0 && return zero(Rational{Int})
      110             r = m * abs(m) // (J * (J + 1))
      110             r *= (J + p + 2) * (p + 1 - J) // d
      110         elseif LSJcase == 4
      110             r = -(L + m) * (L - m) // (L * (2J + 1))
      110             r *= (p - J) * (p + 1 - J) // d
        -         end
     1355     elseif δ1 == 1 && δ2 == -1
      470         if LSJcase == 1
      125             r = (J + m + 1) * (J - m) // d
      345         elseif LSJcase == 2
      110             r = -(p + 1 + J) * (p + 1 - J) // (J * (2J + 1))
      110             r *= (J + m + 1) * (J + m) // d
      235         elseif LSJcase == 3
      125             r = (p + 1) * (p + 1) // (J * (J + 1))
      125             r *= (J + m + 1) * (J - m) // d
      110         elseif LSJcase == 4
      110             r = -(p + 1 + L) * (p + 1 - L) // (L * (2J + 1))
      110             r *= (J - m + 1) * (J - m) // d
        -         end
      885     elseif δ1 == -1 && δ2 == 1
      470         if LSJcase == 1
      125             r = -(J + m) * (J - m + 1) // d
      345         elseif LSJcase == 2
      110             r = (p + 1 + J) * (p + 1 - J) // (J * (2J + 1))
      110             r *= (J - m) * (J - m + 1) // d
      235         elseif LSJcase == 3
      125             r = (p + 1) * (p + 1) // (J * (J + 1))
      125             r *= (J + m) * (J - m + 1) // d
      110         elseif LSJcase == 4
      110             r = (p + 1 + L) * (p + 1 - L) // (L * (2J + 1))
      110             r *= (J + m + 1) * (J + m) // d
        -         end
      415     elseif δ1 == -1 && δ2 == -1
      415         if LSJcase == 1
      110             r = (J + p + 1) * (p - J) // d
      305         elseif LSJcase == 2
       85             r = -(J + m) * (J - m) // (J * (2J + 1))
       85             r *= (p - J) * (p + 1 - J) // d
      220         elseif LSJcase == 3
      110             m == 0 && return zero(Rational{Int})
       80             r = -m * abs(m) // (J * (J + 1))
       80             r *= (J + p + 1) * (p - J) // d
      110         elseif LSJcase == 4
      110             r = (L + m) * (L - m) // (L * (2J + 1))
      110             r *= (J + p + 1) * (J + p + 2) // d
        -         end
        -     end
     1837     return r
        - end
